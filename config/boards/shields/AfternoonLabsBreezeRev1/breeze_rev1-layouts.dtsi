#include <physical_layouts.dtsi>

/ {
	physical_layout0: physical_layout_0 {
		compatible = "zmk,physical-layout";
		display-name = "Default Layout";
		transform = <&default_transform>;
		keys  //                     w   h    x    y    rot    rx    ry
			= <&key_physical_attrs 100 100    0   38      0     0     0>  // Esc
			, <&key_physical_attrs 100 100  100   38      0     0     0>  // 1
			, <&key_physical_attrs 100 100  200   12      0     0     0>  // 2
			, <&key_physical_attrs 100 100  300    0      0     0     0>  // 3
			, <&key_physical_attrs 100 100  400   12      0     0     0>  // 4
			, <&key_physical_attrs 100 100  500   25      0     0     0>  // 5
			, <&key_physical_attrs 100 100  975   25      0     0     0>  // 6
			, <&key_physical_attrs 100 100 1075   12      0     0     0>  // 7
			, <&key_physical_attrs 100 100 1175    0      0     0     0>  // 8
			, <&key_physical_attrs 100 100 1275   12      0     0     0>  // 9
			, <&key_physical_attrs 100 100 1375   38      0     0     0>  // 0
			, <&key_physical_attrs 100 100 1475   38      0     0     0>  // Bksp
			, <&key_physical_attrs 100 100 1600   38      0     0     0>  // -
			, <&key_physical_attrs 100 100 1700   38      0     0     0>  // =
			, <&key_physical_attrs 100 100 1800   38      0     0     0>  // `

			, <&key_physical_attrs 100 100    0  138      0     0     0>  // Tab
			, <&key_physical_attrs 100 100  100  138      0     0     0>  // Q
			, <&key_physical_attrs 100 100  200  112      0     0     0>  // W
			, <&key_physical_attrs 100 100  300  100      0     0     0>  // E
			, <&key_physical_attrs 100 100  400  112      0     0     0>  // R
			, <&key_physical_attrs 100 100  500  125      0     0     0>  // T
			, <&key_physical_attrs 100 100  975  125      0     0     0>  // Y
			, <&key_physical_attrs 100 100 1075  112      0     0     0>  // U
			, <&key_physical_attrs 100 100 1175  100      0     0     0>  // I
			, <&key_physical_attrs 100 100 1275  112      0     0     0>  // O
			, <&key_physical_attrs 100 100 1375  138      0     0     0>  // P
			, <&key_physical_attrs 100 100 1475  138      0     0     0>  // Del
			, <&key_physical_attrs 100 100 1600  138      0     0     0>  // [
			, <&key_physical_attrs 100 100 1700  138      0     0     0>  // ]
			, <&key_physical_attrs 100 100 1800  138      0     0     0>  // End

			, <&key_physical_attrs 100 100    0  238      0     0     0>  // LCtrl
			, <&key_physical_attrs 100 100  100  238      0     0     0>  // A
			, <&key_physical_attrs 100 100  200  212      0     0     0>  // S
			, <&key_physical_attrs 100 100  300  200      0     0     0>  // D
			, <&key_physical_attrs 100 100  400  212      0     0     0>  // F
			, <&key_physical_attrs 100 100  500  225      0     0     0>  // G
			, <&key_physical_attrs 100 100  975  225      0     0     0>  // H
			, <&key_physical_attrs 100 100 1075  212      0     0     0>  // J
			, <&key_physical_attrs 100 100 1175  200      0     0     0>  // K
			, <&key_physical_attrs 100 100 1275  212      0     0     0>  // L
			, <&key_physical_attrs 100 100 1375  238      0     0     0>  // ;
			, <&key_physical_attrs 100 100 1475  238      0     0     0>  // '
			, <&key_physical_attrs 100 100 1600  238      0     0     0>  // Up
			, <&key_physical_attrs 100 100 1700  238      0     0     0>  // Up
			, <&key_physical_attrs 100 100 1800  238      0     0     0>  // Up

			, <&key_physical_attrs 100 100    0  338      0     0     0>  // LShift
			, <&key_physical_attrs 100 100  100  338      0     0     0>  // Z
			, <&key_physical_attrs 100 100  200  312      0     0     0>  // X
			, <&key_physical_attrs 100 100  300  300      0     0     0>  // C
			, <&key_physical_attrs 100 100  400  312      0     0     0>  // V
			, <&key_physical_attrs 100 100  500  325      0     0     0>  // B
			, <&key_physical_attrs 100 100  975  325      0     0     0>  // N
			, <&key_physical_attrs 100 100 1075  312      0     0     0>  // M
			, <&key_physical_attrs 100 100 1175  300      0     0     0>  // ,
			, <&key_physical_attrs 100 100 1275  312      0     0     0>  // .
			, <&key_physical_attrs 100 100 1375  338      0     0     0>  // /
			, <&key_physical_attrs 100 100 1475  338      0     0     0>  // RShift
			, <&key_physical_attrs 100 100 1600  338      0     0     0>  // Left
			, <&key_physical_attrs 100 100 1700  338      0     0     0>  // Down
			, <&key_physical_attrs 100 100 1800  338      0     0     0>  // Right

			, <&key_physical_attrs 100 100  250  425      0     0     0>  // LWIN
			, <&key_physical_attrs 100 100  350  425      0     0     0>  // LALT
			, <&key_physical_attrs 100 100  450  450      0     0     0>  // mo2
			, <&key_physical_attrs 100 200  625  375   3000   650   425>  // Enter
			, <&key_physical_attrs 100 200  900  225  (-3000)  1225   450>  // Space
			, <&key_physical_attrs 100 100 1025  450      0     0     0>  // mo1
			, <&key_physical_attrs 100 100 1125  425      0     0     0>  // RALT
			, <&key_physical_attrs 100 100 1225  425      0     0     0>  // RWIN
			;
	};
};
